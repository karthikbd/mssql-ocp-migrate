include README.md LICENSE THIRD_PARTY_NOTICES.md SECURITY.md CONTRIBUTING.md CHANGELOG.md .readthedocs.yaml GOVERNANCE.md CODE_OF_CONDUCT.md ROADMAP.md vex.openvex.json
recursive-include docs *.md *.py *.css
recursive-include tests *.py *.sql *.yml
recursive-include .clusterfuzzlite *
recursive-include deploy *
recursive-include ci *.in *.txt *.py
prune .codacy
prune docs/_build
prune docs/reference/_generated
global-exclude __pycache__ *.pyc
